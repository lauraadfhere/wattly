{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:next": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "appwrite:setup": "node --env-file=.env.local scripts/setup-appwrite.mjs",
    "demo:user": "node --env-file=.env.local scripts/ensure-demo-user.mjs",
    "cloudinary:folders": "node --env-file=.env.local scripts/ensure-cloudinary-folders.mjs",
    "messages:sync": "node scripts/sync-messages-ts.mjs",
    "cf:sync-vars": "node --env-file=.env.local scripts/sync-cloudflare-vars.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "appwrite": "^29.3.1",
    "cloudinary": "^2.11.0",
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "node-appwrite": "^32.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.165.0"
  },
  "packageManager": "yarn@4.18.1"
}
