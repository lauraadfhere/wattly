# Cloudflare Worker sync (optional API token).
# yarn cf:sync-vars works with Wrangler OAuth even if CLOUDFLARE_API_TOKEN is empty.
CLOUDFLARE_ACCOUNT_ID=1b0d0da111bf8727b19e095d1d1e9694
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_NAME=wattly

# Secrets uploaded from .env.local by yarn cf:sync-vars:
#   APPWRITE_API_KEY
#   CLOUDINARY_API_KEY
#   CLOUDINARY_API_SECRET
#   CLOUDINARY_CLOUD_NAME
#   CLOUDINARY_URL
# Plain vars on deploy (wrangler.jsonc):
#   NEXT_PUBLIC_APPWRITE_ENDPOINT
#   NEXT_PUBLIC_APPWRITE_PROJECT_ID
#   NEXT_PUBLIC_APPWRITE_DATABASE_ID
#   NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME
#   NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET
